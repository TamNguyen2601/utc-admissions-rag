# Generate JWT_SECRET locally (at least 32 random bytes); never commit .env.
# uv run --locked python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_ISSUER=utc-admissions-local
JWT_AUDIENCE=utc-admissions-web
DATABASE_URL=sqlite:///./data/utc.db
# Optional: backend can start without a Gemini key. No live Gemini calls at T007.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_DEVICE=cpu
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
IMPORT_DIR=./data/import
MODEL_CACHE_DIR=./data/models
CORS_ORIGINS=["http://localhost:5173"]
RETRIEVAL_MIN_SIMILARITY=0.75
CHAT_DEADLINE_SECONDS=60
TESSERACT_CMD=tesseract
TESSDATA_PREFIX=
OCR_LANGUAGES=vie+eng
OCR_PAGE_TIMEOUT_SECONDS=60
INGESTION_ITEM_TIMEOUT_SECONDS=300
MAX_DOCUMENT_PAGES=200
